# Copy to .env and edit. Lines starting with # are ignored.

# --- Voice (required for cloning) -------------------------------------------
# Reference clip: 5-10 s of clean speech, no silence or fade-out at the end
# (check with: python prep_prompt.py voices/reference.wav)
PROMPT_WAV=./voices/reference.wav
# Exact transcript of the clip. A final "." is added if missing.
PROMPT_TEXT="Exact words spoken in the reference audio."
VOICE_NAME=myvoice
# -1 = random each time, or a fixed integer for repeatable output
VOICE_SEED=-1

# --- Server ------------------------------------------------------------------
MING_PORT=10212
CUDA_VISIBLE_DEVICES=0

# --- Speed / quality ---------------------------------------------------------
# --cuda-graph: ~2.5-3x faster generation; --flow-steps: more = better quality
EXTRA_ARGS="--cuda-graph --flow-steps 12"

# --- Streaming behavior (defaults shown) ------------------------------------
PREBUFFER_SECONDS=1.5
MIN_MERGED_SECONDS=4.0
SAMPLES_PER_CHUNK=4096

# --- Optional ---------------------------------------------------------------
# MING_DEBUG=1          # verbose logging
# FLASH_ATTN=0          # skip flash-attn (no speedup for the 0.5b model)
# MODEL_ID=inclusionAI/Ming-3.0-tts-0.5b
